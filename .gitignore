# Dependencies
node_modules/

# Build output (regenerated by `npm run build`; deployed as a workflow artifact,
# never committed)
dist/

# Squiffy writes compiled output next to its .squiffy source; scripts/build.mjs
# moves it into dist/ and cleans up, but ignore it here too in case a build is
# interrupted.
stories/**/index.html
stories/**/story.js
stories/**/squiffy.runtime.global.js
stories/**/style.css

# OS cruft
.DS_Store
